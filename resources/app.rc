#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
IDI_TUBEGRAB ICON "tubegrab.ico"

IDD_DOWNLOAD_OPTIONS DIALOGEX 0, 0, 362, 224
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Download options"
FONT TG_UI_FONT_POINTS, TG_UI_FONT_FAMILY, 400, 0, 1
BEGIN
 GROUPBOX "Media", IDC_OPT_MEDIA_GROUP, 10, 8, 342, 74
 LTEXT "&Format:", IDC_OPT_FORMAT_LABEL, 22, 29, 38, 12
 COMBOBOX IDC_OPT_FORMAT, 64, 26, 116, 70, CBS_DROPDOWNLIST | WS_TABSTOP
 LTEXT "&Quality:", IDC_OPT_QUALITY_LABEL, 194, 29, 38, 12
 COMBOBOX IDC_OPT_QUALITY, 234, 26, 106, 86, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "", IDC_OPT_COMPATIBILITY, 22, 57, 318, 14
 GROUPBOX "Destination", IDC_OPT_DEST_GROUP, 10, 90, 342, 92
 LTEXT "Save &to:", IDC_OPT_DEST_LABEL, 22, 108, 44, 12
 EDITTEXT IDC_OPT_DESTINATION, 22, 123, 256, 16, ES_AUTOHSCROLL | WS_TABSTOP
 PUSHBUTTON "&Browse…", IDC_OPT_BROWSE, 286, 122, 54, 18
 AUTOCHECKBOX "Create a folder named after the playlist", IDC_OPT_FOLDER, 22, 146, 318, 13, WS_TABSTOP
 AUTOCHECKBOX "Skip videos already in download history", IDC_OPT_SKIP, 22, 163, 318, 13, WS_TABSTOP
 DEFPUSHBUTTON "Save", IDOK, 226, 196, 60, 20
 PUSHBUTTON "Cancel", IDCANCEL, 292, 196, 60, 20
END
1 VERSIONINFO
 FILEVERSION 2,3,0,0
 PRODUCTVERSION 2,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "TubeGrab native video downloader\0"
   VALUE "FileVersion", "2.3.0\0"
   VALUE "InternalName", "TubeGrab\0"
   VALUE "OriginalFilename", "TubeGrab.exe\0"
   VALUE "ProductName", "TubeGrab\0"
   VALUE "ProductVersion", "2.3.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
